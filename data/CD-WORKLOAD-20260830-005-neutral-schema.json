{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cd005:neutral-schema:enriched-biography-graph:1.0",
  "title": "Study 005 Value-Free Enriched Biography Graph Schema",
  "description": "Machine vocabulary and graph-placement contract only. This schema contains no target payload values.",
